{
  "name": "visenia-monorepo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.4.2",
  "description": "Monorepo de Viseña - Proyecto INVENTA",
  "workspaces": [
    "app"
  ],
  "scripts": {
    "lint": "eslint . --ext .ts,.tsx,.js,.json",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md,yml,yaml}\"",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,yml,yaml}\"",
    "test": "bun run --cwd app test",
    "build": "bun run --cwd app build"
  },
  "devDependencies": {
    "prettier": "^3.3.3"
  }
}
